{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/check_updates.py\" --hook --plugin-root \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 15,
            "statusMessage": "ASDR: checking for updates..."
          }
        ]
      }
    ]
  }
}
