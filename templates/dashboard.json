{
  "_about": "Copied to .harness/dashboard.json by init. build_dashboard.py reads it for the things no other ASDR file knows: where the project runs and lives, and who the client is. Never put passwords, tokens or keys here — test logins list role names only; credentials stay in environment variables. The client status report (build_dashboard.py --audience client) shows environments unless \"client\": false or on localhost, and only links with \"client\": true.",
  "project": "<Product name>",
  "client": {
    "name": "<Client company>",
    "reference": "<BK-2026-NNN>",
    "contact": "<you@yourfirm.com>",
    "hide_risks": []
  },
  "environments": [
    {
      "name": "Local dev",
      "url": "http://localhost:3000",
      "purpose": "developer machine",
      "branch": "feature/*",
      "check": false,
      "client": false
    },
    {
      "name": "Test / QA",
      "url": "<https://test.example.com>",
      "purpose": "automated suites and manual QA",
      "deployed": "<commit or version>",
      "test_roles": [
        "<member>",
        "<admin>"
      ],
      "health_url": "<https://test.example.com/health>"
    },
    {
      "name": "Staging / UAT",
      "url": "<https://staging.example.com>",
      "purpose": "client acceptance",
      "deployed": "<release candidate>",
      "test_roles": [
        "<member>",
        "<admin>"
      ]
    },
    {
      "name": "Production",
      "url": "<https://app.example.com>",
      "purpose": "live users",
      "deployed": "<version>"
    }
  ],
  "repos": [
    {
      "name": "app",
      "url": "<https://github.com/org/app>",
      "purpose": "application code"
    },
    {
      "name": "infra",
      "url": "<https://github.com/org/infra>",
      "purpose": "infrastructure as code and CI"
    }
  ],
  "links": [
    {
      "label": "CI pipeline",
      "url": "<https://github.com/org/app/actions>",
      "client": false
    },
    {
      "label": "Test report (private page)",
      "url": "<claude.ai artifact link>",
      "client": false
    },
    {
      "label": "User manuals (private page)",
      "url": "<claude.ai artifact link>",
      "client": false
    },
    {
      "label": "Issue tracker",
      "url": "<https://…>",
      "client": false
    },
    {
      "label": "UAT feedback form",
      "url": "<https://…>",
      "client": true
    }
  ]
}
